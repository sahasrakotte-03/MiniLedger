{
  "name": "miniledger-workspace",
  "version": "1.0.0",
  "description": "MiniLedger - Full-Stack Mobile & Backend Solution for Tracking Loans to Friends",
  "scripts": {
    "start": "npm --prefix frontend start",
    "dev": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run web",
    "dev:mobile": "npm --prefix frontend start",
    "test:backend": "npm --prefix backend test",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:studio": "npm --prefix backend run prisma:studio"
  },
  "keywords": [
    "miniledger",
    "react-native",
    "expo",
    "nodejs",
    "express",
    "postgresql",
    "prisma",
    "typescript"
  ],
