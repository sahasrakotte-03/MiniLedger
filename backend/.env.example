# MiniLedger Backend Environment Variables
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miniledger?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-miniledger"
JWT_EXPIRES_IN="30d"
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Application & Uploads URL
APP_URL="http://localhost:5000"
